<?xml version="1.0" encoding="UTF-8"?>
<yaazhi-config>

    <settings>
        <locale value="en_US"/>
        <time_zone value="US/Pacific"/>
        <database_time_zone value="US/Pacific"/>
    </settings>

     <web-server>
        <host value="127.0.0.1"/>
        <port-http value="8080"/>
        <port-https value=""/>
        <https-enabled value="false"/>
        <allow-origins value="*"/>
        <handle-cors value="true"/>
    </web-server>

     <databases>

        <data-types>
            <property name="id" pg-sql-type="VARCHAR(64)" mysql-sql-type="VARCHAR(64)" sqlite-sql-type="TEXT"/>
            <property name="id-long" pg-sql-type="VARCHAR(255)" mysql-sql-type="VARCHAR(255)" sqlite-sql-type="TEXT"/>
            <property name="text-indicator" pg-sql-type="CHAR(1)" mysql-sql-type="CHAR(1)" sqlite-sql-type="TEXT"/>
            <property name="text-short" pg-sql-type="VARCHAR(63)" mysql-sql-type="VARCHAR(63)" sqlite-sql-type="TEXT"/>
            <property name="text-medium" pg-sql-type="VARCHAR(255)" mysql-sql-type="VARCHAR(255)" sqlite-sql-type="TEXT"/>
            <property name="text-intermediate" pg-sql-type="VARCHAR(1023)" mysql-sql-type="VARCHAR(1023)" sqlite-sql-type="TEXT"/>
            <property name="text-long" pg-sql-type="VARCHAR(4095)" mysql-sql-type="VARCHAR(4095)" sqlite-sql-type="TEXT"/>
            <property name="text-very-long" pg-sql-type="TEXT" mysql-sql-type="LONGTEXT" sqlite-sql-type="TEXT"/>
            <property name="binary-very-long" pg-sql-type="BYTEA" mysql-sql-type="LONGBLOB" sqlite-sql-type="BLOB"/>
            <property name="date" pg-sql-type="DATE" mysql-sql-type="DATE" sqlite-sql-type="TEXT"/>
            <property name="date-time" pg-sql-type="TIMESTAMP" mysql-sql-type="DATETIME" sqlite-sql-type="TEXT"/>
            <property name="number-integer" pg-sql-type="BIGINT" mysql-sql-type="BIGINT" sqlite-sql-type="INTEGER"/>
            <property name="number-decimal" pg-sql-type="NUMERIC(26,6)" mysql-sql-type="DECIMAL(26,6)" sqlite-sql-type="TEXT"/>
            <property name="number-float" pg-sql-type="DOUBLE PRECISION" mysql-sql-type="DOUBLE" sqlite-sql-type="REAL"/>
            <property name="currency-amount" pg-sql-type="NUMERIC(24,4)" mysql-sql-type="DECIMAL(24,4)" sqlite-sql-type="TEXT"/>
            <property name="currency-precise" pg-sql-type="NUMERIC(25,5)" mysql-sql-type="DECIMAL(25,5)" sqlite-sql-type="TEXT"/>
        </data-types>

        <connection name="sqlite_dev" type="sqlite">
            <file-path value="/db/sqlite/yaazhi_dev.db"/>
            <create-file value="true"/>
            <read-only value="false"/>
            <pool max="50" min="5">
                <timeouts connect="8" acquire="8" idle="8"/>
                <logging enabled="true" level="debug"/>
            </pool>
        </connection>

        <connection name="postgres_prod" type="postgresql">
            <host value="db-server.example.com"/>
            <port value="5432"/>
            <username value="admin"/>
            <password value="securepassword"/>
            <database value="yaazhi_prod"/>
            <pool max="200" min="10">
                <timeouts connect="5" acquire="5" idle="15"/>
                <logging enabled="true" level="info"/>
            </pool>
        </connection>

        <connection name="mysql_test" type="mysql">
            <host value="mysql-test.example.com"/>
            <port value="3306"/>
            <username value="tester"/>
            <password value="testpass"/>
            <database value="yaazhi_test"/>
            <pool max="100" min="10">
                <timeouts connect="6" acquire="6" idle="12"/>
                <logging enabled="true" level="warn"/>
            </pool>
        </connection>

        <default name="sqlite_dev" />

     </databases>


</yaazhi-config>